h_probe_mtr_15_clean_v0_1","source_version":"v0.1"},{"node_id":"evidence:mplifier_graph_probe_mtr_15_clean_v0_1:cmu3h2cny0014bn5kmtm8sjem:0001","node_kind":"evidence","video_id":"video:cmu3h2cny0014bn5kmtm8sjem","aspect_type":"","aspect_family":"","aspect_value":"","aspect_value_normalized":"","evidence_kind":"source_metadata","evidence_lane":"metadata","text":"{\"additionalData\": {\"channelId\": \"UCAjKRiZ-UeH2Bz4Cu-ZEtUg\"}, \"author\": {\"displayName\": \"MTR Hong Kong\"}, \"createdAt\": \"2025-11-09T00:00:00.000Z\", \"platform\": \"youtube\", \"type\": \"video\"}","text_contains_http":"0.0","youtube_video_id":"","brand_family":"","title":"","source_package":"mplifier_graph_probe_mtr_15_clean_v0_1","source_version":"v0.1"},{"node_id":"evidence:mplifier_graph_probe_mtr_15_clean_v0_1:cmu3h2cny0014bn5kmtm8sjem:0002","node_kind":"evidence","video_id":"video:cmu3h2cny0014bn5kmtm8sjem","aspect_type":"","aspect_family":"","aspect_value":"","aspect_value_normalized":"","evidence_kind":"title_text","evidence_lane":"metadata","text":"東涌綫延綫隧道 - 鑽挖篇 Tung Chung Line Extension - Tunnel Boring Works","text_contains_http":"0.0","youtube_video_id":"","brand_family":"","title":"","source_package":"mplifier_graph_probe_mtr_15_clean_v0_1","source_version":"v0.1"},{"node_id":"evidence:mplifier_graph_probe_mtr_15_clean_v0_1:cmu3h2cny0014bn5kmtm8sjem:0003","node_kind":"evidence","video_id":"video:cmu3h2cny0014bn5kmtm8sjem","aspect_type":"","aspect_family":"","aspect_value":"","aspect_value_normalized":"","evidence_kind":"description_text","evidence_lane":"metadata","text":"【鐵路鑽深啲👷 東涌綫延綫隧道鑽挖篇 #4 】隧道鑽挖機女神「羲和」已經順利完成鑽挖東涌站至東涌西站嘅上行綫隧道喇👏佢今年初由東涌站出發，穿過高山越過大海，一路挖掘、一路鋪好隧道壁，最後成功抵達位於東涌西站嘅豎井，完成佢嘅首躺旅程！ 小編好開心有份親眼見證佢「破牆而出」嘅一刻😍之後「羲和」就會喺豎井掉頭，向返東涌站方向完成埋下行綫隊道鑽挖工程喇～ 📹一齊感受吓「羲和」貫通嘅「震撼」畫面啦！ #羲和 #隧道貫通 #東涌綫延綫 #東涌西站 #新鐵路建設無限未來 [Railway 101👷 – Tung Chung Line Extension’s Tunnel Boring Works #4 ] Earlier this year, Tunnel Boring Machine “Xihe” set off from Tung Chung Station and diligently worked underground — digging through hard rock layers and subsea mixed soil. After overcoming tough geological challenges, it successfully broke through the up-track tunnel to the future Tung Chung West Station, marking a major milestone for the Tung Chung Line Extension! 👏This breakthrough isn’t just a big step in construction — it’s a vital move toward connecting communities and building the future. 🎯 “Xihe” is now being prepared in the U-turn shaft at the Tung Chung West Station worksite, getting ready to start excavating the down-track tunnel toward Tung Chung Station.📹 Let’s feel the power of the epic breakthrough moment via the video! #Xihe #TunnelBreakthrough #TungChungLineExtension #TungChungWestStation #NewRailwaysGoBeyondBoundaries","text_contains_http":"0.0","youtube_video_id":"","brand_family":"","title":"","source_package":"mplifier_graph_probe_mtr_15_clean_v0_1","source_version":"v0.1"},{"node_id":"evidence:mplifier_graph_probe_mtr_15_clean_v0_1:cmu3h2cny0014bn5kmtm8sjem:0004","node_kind":"evidence","video_id":"video:cmu3h2cny0014bn5kmtm8sjem","aspect_type":"","aspect_family":"","aspect_value":"","aspect_value_normalized":"","evidence_kind":"author_metadata","evidence_lane":"metadata","text":"{\"displayName\": \"MTR Hong Kong\"}","text_contains_http":"0.0","youtube_video_id":"","brand_family":"","title":"","source_package":"mplifier_graph_probe_mtr_15_clean_v0_1","source_version":"v0.1"},{"node_id":"evidence:mplifier_graph_probe_mtr_15_clean_v0_1:cmu3h2cny0014bn5kmtm8sjem:0006","node_kind":"evidence","video_id":"video:cmu3h2cny0014bn5kmtm8sjem","aspect_type":"","aspect_family":"","aspect_value":"","aspect_value_normalized":"","evidence_kind":"media_metadata","evidence_lane":"metadata","text":"{\"createdAt\": \"2025-11-09T00:00:00.000Z\", \"duration\": 38, \"thumbnailUrl\": \"https://i.ytimg.com/vi/cru2ZL6HMEg/maxresdefault.jpg\", \"type\": \"video\"}","text_contains_http":"1.0","youtube_video_id":"","brand_family":"","title":"","source_package":"mplifier_graph_probe_mtr_15_cl